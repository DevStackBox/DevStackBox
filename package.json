{
  "name": "devstackbox",
  "version": "0.1.19",
  "description": "A lightweight, portable, open-source local development environment for PHP developers",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-logo.mjs && node scripts/stage-phpmyadmin.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-logo.mjs && node scripts/stage-phpmyadmin.mjs && node scripts/build-php-cli.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:packaging": "node --test scripts/stage-phpmyadmin.check.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:release",
    "prepare-binaries": "node scripts/verify-release.mjs",
    "prepare-binaries-optimized": "node scripts/verify-release.mjs",
    "build:optimized": "npm run build:release",
    "build:release": "node scripts/build-release.mjs",
    "finalize-release": "node scripts/finalize-release.mjs --write-changelog",
    "release": "node scripts/verify-release.mjs",
    "check": "npm test && tsc --noEmit && node scripts/validate-docs.mjs && node scripts/verify-release.mjs",
    "check:ci": "npm test && tsc --noEmit && node scripts/validate-docs.mjs",
    "build:php-cli": "node scripts/build-php-cli.mjs",
    "test:php-cli": "node scripts/build-php-cli.mjs && node --test scripts/php-cli.check.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^5.0.0"
  },
  "author": "Nomad Programmer <hello@devstackbox.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevStackBox/DevStackBox.git"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
