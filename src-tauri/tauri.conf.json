{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevStackBox",
  "version": "0.1.11",
  "identifier": "com.srapsware.devstackbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevStackBox",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Nomad Programmer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../apache": "apache",
      "../mysql": "mysql",
      "../php/8.3": "php/8.3",
      "../phpmyadmin": "phpmyadmin",
      "../www": "www"
    },
    "externalBin": [],
    "copyright": "\u00a9 2026 Nomad Programmer",
    "category": "DeveloperTool",
    "shortDescription": "Local PHP development environment",
    "longDescription": "Free XAMPP alternative for Windows: Apache, MySQL 8.4 LTS, phpMyAdmin, PHP 8.3 bundled; PHP 8.1-8.5 on demand.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "wix/custom-install-dir.wxs"
        ]
      },
      "nsis": {
        "template": "templates/installer.nsi",
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DevStackBox/DevStackBox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNEMzNDE0OTNDNERGMzUKUldRMTM4U1RGRFJNV2t6K2swazFJb0pGVU5iRDQxYU02NzVOZFN4UnVLVHJQa1dveW0zU3pXY3oK"
    }
  }
}
